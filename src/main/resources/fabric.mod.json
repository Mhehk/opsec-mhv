{
	"schemaVersion": 1,
	"id": "opsec_mhv",
	"version": "${version}",
	"name": "OpSec — mhv1",
	"description": "Unofficial mhv1 fork of OpSec with Axiom compatibility. Axiom and its required dependencies are exempt from filtering when installed.",
	"authors": [
		"Aurick"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/opsec",
		"sources": "https://github.com/aurickk/OpSec",
		"issues": "https://github.com/aurickk/OpSec/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/opsec/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"aurick.opsec.mod.OpsecClient"
		],
		"modmenu": [
			"aurick.opsec.mod.config.OpsecModMenuIntegration"
		],
		"mixinsquared": [
			"aurick.opsec.mod.mixin.MeteorMixinCanceller"
		]
	},
	"mixins": [
		{
			"config": "opsec.client.mixins.json",
			"environment": "client"
		}
	],
	"conflicts": {
		"exploitpreventer": "*"
	},
	"breaks": {
		"opsec": "*",
		"ichor": "*",
		"labymod": "*",
		"autismsexdefender": "*"
	},
	"depends": {
		"fabricloader": ">=0.14.0",
		"minecraft": "${minecraft_version_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
